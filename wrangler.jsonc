{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": "worker.js",
	"compatibility_date": "2026-05-27",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	// ponytail: keep per-site public DB vars in Cloudflare, promote to config when deploys get scripted.
	"keep_vars": true,
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"images": {
		"binding": "IMAGES"
	},
	"env": {
		"baanparty": {
			"name": "baan-pool-villa",
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"images": {
				"binding": "IMAGES"
			},
			"vars": {
				"NEXT_PUBLIC_SITE_URL": "https://baanpartypattaya.com"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "baan-pool-villa"
				}
			],
			"r2_buckets": [
				{
					"binding": "NEXT_INC_CACHE_R2_BUCKET",
					"bucket_name": "baan-pool-villa-next-cache"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "NEXT_CACHE_DO_QUEUE",
						"class_name": "DOQueueHandler"
					},
					{
						"name": "NEXT_TAG_CACHE_DO_SHARDED",
						"class_name": "DOShardedTagCache"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"DOQueueHandler"
					]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"DOShardedTagCache"
					]
				}
			],
			"secrets": {
				"required": [
					"DEVILLE_BEARER_TOKEN",
					"SUPABASE_PUBLISHABLE_KEY"
				]
			}
		},
		"baan02": {
			"name": "baan-pool-villa02",
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"images": {
				"binding": "IMAGES"
			},
			"vars": {
				"NEXT_PUBLIC_SITE_URL": "https://baan-pool-villa02.poolvilla.workers.dev"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "baan-pool-villa02"
				}
			],
			"r2_buckets": [
				{
					"binding": "NEXT_INC_CACHE_R2_BUCKET",
					"bucket_name": "baan-pool-villa02-next-cache"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "NEXT_CACHE_DO_QUEUE",
						"class_name": "DOQueueHandler"
					},
					{
						"name": "NEXT_TAG_CACHE_DO_SHARDED",
						"class_name": "DOShardedTagCache"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"DOQueueHandler"
					]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"DOShardedTagCache"
					]
				}
			],
			"secrets": {
				"required": [
					"DEVILLE_BEARER_TOKEN",
					"SUPABASE_PUBLISHABLE_KEY"
				]
			}
		},
		"baanPMhee": {
			"name": "baan-pool-villa03",
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"images": {
				"binding": "IMAGES"
			},
			"vars": {
				"NEXT_PUBLIC_SITE_URL": "https://baan-pool-villa03.poolvilla.workers.dev"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "baan-pool-villa03"
				}
			],
			"r2_buckets": [
				{
					"binding": "NEXT_INC_CACHE_R2_BUCKET",
					"bucket_name": "baan-pool-villa03-next-cache"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "NEXT_CACHE_DO_QUEUE",
						"class_name": "DOQueueHandler"
					},
					{
						"name": "NEXT_TAG_CACHE_DO_SHARDED",
						"class_name": "DOShardedTagCache"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"DOQueueHandler"
					]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"DOShardedTagCache"
					]
				}
			],
			"secrets": {
				"required": [
					"DEVILLE_BEARER_TOKEN",
					"SUPABASE_PUBLISHABLE_KEY"
				]
			}
		},
		"staging": {
			"name": "baan-pool-staging",
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"images": {
				"binding": "IMAGES"
			},
			"vars": {
				"NEXT_PUBLIC_SITE_URL": "https://baan-pool-staging.poolvilla.workers.dev"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "baan-pool-staging"
				}
			],
			"r2_buckets": [
				{
					"binding": "NEXT_INC_CACHE_R2_BUCKET",
					"bucket_name": "baan-pool-staging-next-cache"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "NEXT_CACHE_DO_QUEUE",
						"class_name": "DOQueueHandler"
					},
					{
						"name": "NEXT_TAG_CACHE_DO_SHARDED",
						"class_name": "DOShardedTagCache"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"DOQueueHandler"
					]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"DOShardedTagCache"
					]
				}
			],
			"secrets": {
				"required": [
					"DEVILLE_BEARER_TOKEN",
					"SUPABASE_PUBLISHABLE_KEY"
				]
			}
		}
	},
	"r2_buckets": [
		{
			"bucket_name": "baan-pool-staging-next-cache",
			"binding": "baan_pool_staging_next_cache",
			"remote": true
		}
	]
}