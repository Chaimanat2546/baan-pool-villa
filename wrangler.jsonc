{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": "worker.js",
	"compatibility_date": "2026-05-27",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	// ponytail: keep per-site public DB vars in Cloudflare, promote to config when deploys get scripted.
	"keep_vars": true,
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"images": {
		"binding": "IMAGES"
	},
	"env": {
		"baanparty": {
			"name": "baan-pool-villa",
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"images": {
				"binding": "IMAGES"
			},
			"ratelimits": [
				{
					"name": "CALENDAR_API_RATE_LIMITER",
					"namespace_id": "91013",
					"simple": {
						"limit": 60,
						"period": 60
					}
				},
			],
			"vars": {
				"NEXT_PUBLIC_SITE_URL": "https://www.baanpartypattaya.com",
				"CENTRAL_USER_MANAGER_AGENT_ENABLED": "false"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "baan-pool-villa"
				}
			],
			"r2_buckets": [
				{
					"binding": "NEXT_INC_CACHE_R2_BUCKET",
					"bucket_name": "baan-pool-villa-next-cache"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "NEXT_CACHE_DO_QUEUE",
						"class_name": "DOQueueHandler"
					},
					{
						"name": "NEXT_TAG_CACHE_DO_SHARDED",
						"class_name": "DOShardedTagCache"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"DOQueueHandler"
					]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"DOShardedTagCache"
					]
				}
			],
			"secrets": {
				"required": [
					"CALENDAR_INTERNAL_API_TOKEN",
					"DEVILLE_BEARER_TOKEN",
					"PATTAYA_BOOKINGS_API_TOKEN",
					"SUPABASE_PUBLISHABLE_KEY",
					"SUPABASE_SECRET_KEY",
					"TURNSTILE_SECRET_KEY"
				]
			}
		},
		"baan02": {
			"name": "baan-pool-villa02",
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"images": {
				"binding": "IMAGES"
			},
			"ratelimits": [
				{
					"name": "CALENDAR_API_RATE_LIMITER",
					"namespace_id": "92013",
					"simple": {
						"limit": 60,
						"period": 60
					}
				},
			],
			"vars": {
				"NEXT_PUBLIC_SITE_URL": "https://www.poolvillapattaya.co.th",
				"CENTRAL_USER_MANAGER_AGENT_ENABLED": "false"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "baan-pool-villa02"
				}
			],
			"r2_buckets": [
				{
					"binding": "NEXT_INC_CACHE_R2_BUCKET",
					"bucket_name": "baan-pool-villa02-next-cache"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "NEXT_CACHE_DO_QUEUE",
						"class_name": "DOQueueHandler"
					},
					{
						"name": "NEXT_TAG_CACHE_DO_SHARDED",
						"class_name": "DOShardedTagCache"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"DOQueueHandler"
					]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"DOShardedTagCache"
					]
				}
			],
			"secrets": {
				"required": [
					"CALENDAR_INTERNAL_API_TOKEN",
					"DEVILLE_BEARER_TOKEN",
					"PATTAYA_BOOKINGS_API_TOKEN",
					"SUPABASE_PUBLISHABLE_KEY",
					"SUPABASE_SECRET_KEY",
					"TURNSTILE_SECRET_KEY"
				]
			}
		},
		"baanPMhee": {
			"name": "baan-pool-villa03",
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"images": {
				"binding": "IMAGES"
			},
			"ratelimits": [
				{
					"name": "CALENDAR_API_RATE_LIMITER",
					"namespace_id": "93013",
					"simple": {
						"limit": 60,
						"period": 60
					}
				},
			],
			"vars": {
				"NEXT_PUBLIC_SITE_URL": "https://www.pmheevilla.com",
				"CENTRAL_USER_MANAGER_AGENT_ENABLED": "false"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "baan-pool-villa03"
				}
			],
			"r2_buckets": [
				{
					"binding": "NEXT_INC_CACHE_R2_BUCKET",
					"bucket_name": "baan-pool-villa03-next-cache"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "NEXT_CACHE_DO_QUEUE",
						"class_name": "DOQueueHandler"
					},
					{
						"name": "NEXT_TAG_CACHE_DO_SHARDED",
						"class_name": "DOShardedTagCache"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"DOQueueHandler"
					]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"DOShardedTagCache"
					]
				}
			],
			"secrets": {
				"required": [
					"CALENDAR_INTERNAL_API_TOKEN",
					"DEVILLE_BEARER_TOKEN",
					"PATTAYA_BOOKINGS_API_TOKEN",
					"SUPABASE_PUBLISHABLE_KEY",
					"SUPABASE_SECRET_KEY",
					"TURNSTILE_SECRET_KEY"
				]
			}
		},
		"staging": {
			"name": "baan-pool-villa-staging",
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"images": {
				"binding": "IMAGES"
			},
			"ratelimits": [
				{
					"name": "CALENDAR_API_RATE_LIMITER",
					"namespace_id": "94013",
					"simple": {
						"limit": 60,
						"period": 60
					}
				},
			],
			"vars": {
				"NEXT_PUBLIC_SITE_URL": "https://baan-pool-villa-staging.chaymanus2003.workers.dev",
				"NEXT_PUBLIC_HOME_CONFIG_SUPABASE_URL": "https://lsbbbbibhtbwrvrqggwq.supabase.co",
				"SUPABASE_URL": "https://sxvkhzhqtrpxgzumsswl.supabase.co",
				"CENTRAL_USER_MANAGER_AGENT_ENABLED": "true",
				"CENTRAL_USER_MANAGER_TENANT_ID": "2b4e0c23-b66c-43c8-892c-ac1a9b5f2ccb",
				"CENTRAL_USER_MANAGER_PROJECT_REF": "lsbbbbibhtbwrvrqggwq"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "baan-pool-villa-staging"
				}
			],
			"r2_buckets": [
				{
					"binding": "NEXT_INC_CACHE_R2_BUCKET",
					"bucket_name": "baan-pool-villa-staging-next-cache"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "NEXT_CACHE_DO_QUEUE",
						"class_name": "DOQueueHandler"
					},
					{
						"name": "NEXT_TAG_CACHE_DO_SHARDED",
						"class_name": "DOShardedTagCache"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"DOQueueHandler"
					]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"DOShardedTagCache"
					]
				}
			],
			"secrets": {
				"required": [
					"CALENDAR_INTERNAL_API_TOKEN",
					"DEVILLE_BEARER_TOKEN",
					"PATTAYA_BOOKINGS_API_TOKEN",
					"SUPABASE_PUBLISHABLE_KEY",
					"SUPABASE_SECRET_KEY",
					"TURNSTILE_SECRET_KEY"
				]
			}
		},
	},
}
